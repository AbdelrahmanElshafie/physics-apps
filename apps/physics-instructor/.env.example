# Which tutor transport to wire up at the composition root (src/container.ts).
# "claude-code" = file bridge, answered from the Claude Code terminal (current).
# "anthropic"   = direct API tutor (milestone M3 — adapter not implemented yet).
TUTOR_TRANSPORT=claude-code

# Only read by the anthropic adapter in M3. Never commit a real key.
# ANTHROPIC_API_KEY=

# Set to "off" to skip the SymPy worker and send those answers to the tutor instead.
SYMBOLIC_CHECKING=on

# Override if python is not on PATH under that name.
# PYTHON_BIN=python3
