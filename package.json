{
  "name": "physics-apps",
  "version": "0.0.0",
  "private": true,
  "description": "Monorepo: a launcher plus five independent tutoring apps sharing code via packages/.",
  "scripts": {
    "dev": "pnpm --filter hub dev",
    "dev:all": "pnpm -r --parallel --filter \"./apps/*\" dev",
    "dev:hub": "pnpm --filter hub dev",
    "dev:instructor": "pnpm --filter physics-instructor dev",
    "dev:eg": "pnpm --filter physics-eg dev",
    "dev:chinese": "pnpm --filter chinese-tutor dev",
    "dev:russian": "pnpm --filter russian-tutor dev",
    "dev:spanish": "pnpm --filter spanish-tutor dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck"
  }
}
